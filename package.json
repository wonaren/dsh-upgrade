{
  "name": "dsh-upgrade",
  "version": "1.0.0",
  "description": "DeepSeek Harness (DSH) 版本检测、多通道一键平滑升级与服务守护插件",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "cordis",
    "dsh-plugin",
    "plugin",
    "upgrade",
    "updater",
    "restart"
  ],
  "author": "wonaren",
  "license": "MIT",
  "homepage": "https://github.com/wonaren/dsh-upgrade#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wonaren/dsh-upgrade.git"
  },
  "bugs": {
    "url": "https://github.com/wonaren/dsh-upgrade/issues"
  },
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "engines": {
    "dsh": ">=0.1.0"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "package.json",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-slots"
      ],
      "platform": "web"
    }
  }
}
